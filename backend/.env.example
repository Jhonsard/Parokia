# Parokia Backend — environment variables
# Copy this file to backend/.env and fill in production values.
# NEVER commit backend/.env to version control.

# ── Runtime ──
# development | production | staging
PAROKIA_ENV=development
# Set to "1" to run the FastMCP server instead of the uvicorn REST API
PAROKIA_RUN_MCP=0

# ── Secrets ──
# JWT signing secret — generate with: openssl rand -hex 32
PAROKIA_JWT_SECRET=replace-this-secret-in-production

# ── Server ──
HOST=0.0.0.0
PORT=8000
# PAROKIA_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Database ──
# Leave blank for an ephemeral SQLite file at backend/parokia.db
# PostgreSQL DSN (production): postgresql://user:password@host:5432/parokia_db
# DATABASE_URL=postgresql://parokia_user:password@localhost:5432/parokia_db

# ── Auth / security ──
PAROKIA_ACCESS_TOKEN_MINUTES=60
PAROKIA_CORS_CREDENTIALS=1

# ── Bootstrap (run once, on first startup) ──
PAROKIA_ADMIN_EMAIL=admin@parokia.org
PAROKIA_ADMIN_PASSWORD=change-me-2026

# ── Features ──
PAROKIA_SEED_ON_STARTUP=1
# When 1, a weak/missing JWT secret is a hard error instead of a warning
PAROKIA_STRICT_CONFIG=0
