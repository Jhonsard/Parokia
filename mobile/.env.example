# Parokia Mobile — environment variables
# Copy this file to mobile/.env for local development.
#
# Base URL of the FastAPI backend. Leave it unset during development: the app
# then reuses the Expo bundler host on port 8000, which works on a phone
# connected to the same Wi-Fi as the machine running `python server.py`.
#
# Production builds MUST set this value (HTTPS endpoint of the parish API).
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8000
